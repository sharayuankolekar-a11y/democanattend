# Copy to .env (or set these in your hosting dashboard). NEVER commit the real values.

# Random string, 16+ chars. Signs QR codes and verification tickets.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
QR_SIGNING_SECRET=

# Encrypts stored face templates.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_TEMPLATE_KEY=

# Firebase Admin credentials - use ONE of these (service-account JSON from
# Firebase console > Project settings > Service accounts). Never commit it.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Comma-separated list of frontend origins allowed to call this service.
ALLOWED_ORIGINS=http://localhost:5173

# Optional: lets you reset a student's face profile with  curl -X DELETE -H "X-Admin-Key: ..." <url>/admin/face/<studentDocId>
ADMIN_KEY=

# While tuning on real phones, return raw scores in API responses (turn OFF for the real demo).
DEBUG_SCORES=true

# --- Tunables (defaults shown; light/face thresholds are UNCALIBRATED) ---
# MATCH_THRESHOLD=0.363
# LIGHT_MIN_SCORE=0.6
# LIGHT_MIN_SLOPE=0.02
# LIGHT_LATENCY_MS=120
# TURN_SIGN_FLIP=false
PORT=8000

# --- Liveness behaviour (added in the face-fix update) ---
# auto     (default): clear light match = ok; face reacts but NOT to our colours = rejected;
#                     no measurable reaction (bright room etc.) = allowed but flagged "reduced" on the record.
# enforce : anything except a clear match is rejected - switch to this once your phones show clean scores.
# advisory: the light check is only recorded.   off: skipped.   The head-turn is ALWAYS required.
LIGHT_CHECK_MODE=auto
# either (default): any clear head turn counts (front cameras differ in mirroring). exact: must turn the asked way.
TURN_DIRECTION_MODE=either
# Maximum length of one attendance session in seconds (faculty normally ends it earlier).
ATTENDANCE_WINDOW_S=7200
